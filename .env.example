# Copiá este archivo a .env.local. Sin estas claves la web funciona en local
# con data/db.json y los mensajes quedan en el panel.

AUTH_SECRET=cambia-esto-por-32-caracteres-minimo-ok
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. En Vercel son obligatorias.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → https://resend.com (el dominio del "from" tiene que estar verificado)
RESEND_API_KEY=
EMAIL_FROM=Solera <reservas@tudominio.com>

# WhatsApp Cloud API → Meta for Developers → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Vercel Cron envía Authorization: Bearer CRON_SECRET
CRON_SECRET=
